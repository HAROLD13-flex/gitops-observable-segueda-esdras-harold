{
  "title": "Cluster GitOps - Harold Segueda - Infrastructure",
  "uid": "infra-harold",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "panels": [
    {
      "id": 1,
      "title": "Nœuds Kubernetes (Ready)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "targets": [
        { "expr": "count(kube_node_status_condition{condition=\"Ready\", status=\"true\"})" }
      ]
    },
    {
      "id": 2,
      "title": "Pods en cours d'exécution",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "targets": [
        { "expr": "count(kube_pod_status_phase{phase=\"Running\"} == 1)" }
      ]
    },
    {
      "id": 3,
      "title": "CPU utilisé par nœud (%)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [
        {
          "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Mémoire utilisée par nœud (%)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "100 * (1 - ((node_memory_MemFree_bytes + node_memory_Cached_bytes + node_memory_Buffers_bytes) / node_memory_MemTotal_bytes))",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Espace disque utilisé (%)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "targets": [
        {
          "expr": "100 - ((node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay\"} * 100) / node_filesystem_size_bytes{fstype!~\"tmpfs|overlay\"})",
          "legendFormat": "{{instance}} - {{mountpoint}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Pods par nœud",
      "type": "table",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "targets": [
        { "expr": "count(kube_pod_info) by (node)" }
      ]
    },
    {
      "id": 7,
      "title": "Deployments disponibles / attendus",
      "type": "table",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 22 },
      "targets": [
        { "expr": "kube_deployment_status_replicas_available" },
        { "expr": "kube_deployment_spec_replicas" }
      ]
    }
  ]
}